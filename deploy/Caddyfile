# HTTPS certificates are issued automatically (Let's Encrypt). DNS: A-records for DOMAIN and sb.DOMAIN → server IP.

{$DOMAIN} {
	encode zstd gzip
	reverse_proxy app:3000 {
		# The app's rate limits trust only this header
		header_up X-Real-IP {remote_host}
	}
}

# Self-hosted Supabase on this server: REST, Auth, Storage and the Realtime websocket.
# Only the APIs the app uses are public; Studio is reachable through an SSH tunnel (see README).
sb.{$DOMAIN} {
	@api path /auth/v1/* /rest/v1/* /realtime/v1/* /storage/v1/*
	handle @api {
		reverse_proxy api-gw:8000
	}
	handle {
		respond 404
	}
	header -server
}

# Internal only (no published port): email templates that Supabase Auth downloads on start
:8088 {
	root * /srv/mail-templates
	file_server
}
