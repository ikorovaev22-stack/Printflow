# Домен сайта. В DNS нужны две A-записи на IP сервера: DOMAIN и sb.DOMAIN
DOMAIN=app.example.ru
# Хост проекта Supabase (Settings → API → Project URL без https://)
SUPABASE_HOST=xxxx.supabase.co

# Браузер обращается к Supabase через прокси на вашем домене
NEXT_PUBLIC_SUPABASE_URL=https://sb.app.example.ru
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=https://app.example.ru
NEXT_PUBLIC_APP_NAME=PrintFlow
DEFAULT_COMPANY_SLUG=
DEMO_MODE=false

# Push-уведомления: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.ru

# Email клиентам (необязательно)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Типография <noreply@example.ru>"
