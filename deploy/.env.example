# Настройки приложения на своём сервере. Скопируйте в deploy/.env, заполните и запустите: sh deploy/install.sh
# Ключи Supabase, пароль базы и ключи push-уведомлений install.sh создаёт сам (deploy/supabase/.env).

# Домен приложения. В DNS нужны две A-записи на IP сервера: DOMAIN и sb.DOMAIN
DOMAIN=app.example.ru
# Название во вкладке браузера и на входе в панель
APP_NAME="Арт Проджект"
# Адрес типографии (/c/<slug>), куда ведёт корень сайта. Пусто — первая созданная типография
DEFAULT_COMPANY_SLUG=artproject

# Почта: подтверждение email, восстановление пароля и уведомления клиентам.
# Яндекс: smtp.yandex.ru, порт 465, пароль приложения (id.yandex.ru → Безопасность → Пароли приложений).
# Без SMTP регистрация работает без подтверждения почты, а восстановить пароль клиенты не смогут.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Адрес отправителя (обычно совпадает с SMTP_USER) и подпись
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Типография
# true — клиент подтверждает почту по ссылке из письма перед первым входом (нужен SMTP)
CONFIRM_EMAIL=false

# Копия бэкапов вне сервера (необязательно): S3-хранилище в России — Selectel, Yandex Object Storage, VK Cloud.
# Каждую ночь новые файлы из deploy/backups копируются в BACKUP_S3_BUCKET/BACKUP_S3_PREFIX, старше 14 дней — удаляются.
# Адрес и регион: Selectel — https://s3.ru-1.storage.selcloud.ru и ru-1, Yandex — https://storage.yandexcloud.net и ru-central1
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=ru-1
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=printflow
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
