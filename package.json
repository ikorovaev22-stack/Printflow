    "test:unit": "node --import tsx --test tests/pricing.test.ts tests/assistant.test.ts",
    "test:rls": "node --import tsx --test tests/rls.test.ts",
    "create-company": "tsx scripts/create-company.ts",
    "create-staff": "tsx scripts/create-staff.ts",
    "test:e2e": "playwright test",
    "ai:compare": "tsx scripts/ai-compare.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.49.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.0.13",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
