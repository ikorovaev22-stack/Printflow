# ── Supabase (обязательно) ─────────────────────────────────────────────
# Settings → API. При запуске на своём сервере в РФ укажите адрес прокси (https://sb.ваш-домен.ru)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Только на сервере, никогда в браузере: уведомления, скрипты create-company и seed, тест RLS
SUPABASE_SERVICE_ROLE_KEY=
# Миграции: Settings → Database → Connection string → Session pooler (IPv4)
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ── Сайт ──────────────────────────────────────────────────────────────
# Публичный адрес без слэша в конце: ссылки в уведомлениях и письмах
NEXT_PUBLIC_SITE_URL=https://app.example.ru
# Название продукта во вкладке браузера и на входе в панель
NEXT_PUBLIC_APP_NAME=PrintFlow
# Адрес типографии (/c/<slug>), куда ведёт корень сайта. Пусто — первая созданная типография
DEFAULT_COMPANY_SLUG=
# true — на главной лендинг продукта с демо-доступами (только для демо-стенда)
DEMO_MODE=false

# ── Push-уведомления (необязательно) ──────────────────────────────────
# Сгенерировать: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.ru

# ── Email-уведомления клиентам (необязательно) ────────────────────────
# Например, Яндекс 360: smtp.yandex.ru, порт 465, пароль приложения
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Типография <noreply@example.ru>"
